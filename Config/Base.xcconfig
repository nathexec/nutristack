// Standards de compilation communs (Plan §4 : aucun avertissement toléré).
SWIFT_VERSION = 5.10
IPHONEOS_DEPLOYMENT_TARGET = 17.0
// Concurrence : « targeted » pour la cible applicative, le temps du SDK iOS 17.
//
// SwiftUI n’y est pas encore entièrement annotée pour l’isolation d’acteur ;
// exiger « complete » sur du code de vue impose des contournements non
// idiomatiques sans gain de sûreté réel. Les deux paquets de logique, eux, sont
// écrits pour passer le mode strict : types valeur Sendable, aucun état global
// muable, isolation explicite là où elle compte. Le passage de l’ensemble au
// mode langage Swift 6 est planifié avec l’adoption du SDK iOS 18 (Plan §4).
SWIFT_STRICT_CONCURRENCY = targeted
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
